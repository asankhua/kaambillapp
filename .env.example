# ─────────────────────────────────────────────────────────────────────────────
# KaamBill: environment variables (TEMPLATE, no real secrets)
#
# Local dev:   cp .env.example .env   (at the repo root; git-ignored), then set GROQ_API_KEY.
# Production:  set the SERVER variables in Vercel → Project → Settings → Environment Variables.
#
#   SERVER  (no prefix)  → only readable by the /api functions. Secrets go HERE.
#   CLIENT  (VITE_ ...)  → bundled into the browser app and visible to anyone.
#                          NEVER put an API key in a VITE_ variable.
#
# Not needed at all: Wispr Flow (a dictation app the user signs in to; it types into
# KaamBill's text box like a keyboard, no key), and no text-to-speech service (the app never speaks).
# See docs/architecture.md §13 for what each service is used for.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════ REQUIRED ═══════════════════════════════════════════

# Groq: bill extraction (/api/extract) and the optional Whisper speech-to-text (/api/stt).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=


# ═════════════════════════ OPTIONAL (defaults shown; uncomment to change) ═══════

# --- Server: LLM extraction ---------------------------------------------------
# LLM_MODEL=openai/gpt-oss-120b
# LLM_FALLBACK_MODEL=openai/gpt-oss-20b      # used once after a 429 or timeout
# LLM_REASONING_EFFORT=low                   # low | medium | high
# LLM_MAX_TOKENS=640                         # counts against Groq's tokens-per-minute limit
# EXTRACT_TIMEOUT_MS=6000

# --- Server: abuse and cost protection (set these in PRODUCTION) ----------------
# Allowed origins (CORS + Origin check). Default allows only http://localhost:5173.
# ALLOWED_ORIGINS=https://kaambill.vercel.app
# RATE_LIMIT_PER_MIN=30
# Persistent rate-limit store (in-memory limits don't hold across serverless instances):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Server: Groq Whisper speech-to-text (reuses GROQ_API_KEY) --------------------
# GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Server: cloud speech-to-text backend (POST /api/stt) -----------------------------
# VOICE_PROVIDER picks the backend when a request doesn't name one, and is what the Whisper
# second pass uses: groq (default, reuses GROQ_API_KEY) | sarvam (Sarvam AI, needs the key below).
# VOICE_PROVIDER=groq
# Sarvam AI (https://dashboard.sarvam.ai): strong on Hindi, Hinglish and Indian-accented English.
# Required only when VOICE_PROVIDER=sarvam or the mic engine is sarvam (see VITE_STT_PROVIDER below).
# SARVAM_API_KEY=
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_STT_MODE=codemix                    # transcribe | translate | verbatim | translit | codemix

# --- Server: logging (logs never contain customer phone numbers) ---------------------
# LOG_LEVEL=info                             # debug | info | warn | error

# --- Client: in-app mic engine (the green mic button; Wispr Flow needs nothing here) --------
# webspeech (default, browser, no key) | groq-whisper | sarvam (Sarvam AI) | webspeech+whisper
# (second pass on the VOICE_PROVIDER backend when confidence < 0.85). Also selectable per visit with ?stt=...
# VITE_STT_PROVIDER=webspeech
# VITE_VAD_SILENCE_MS=4000                   # pause (ms) allowed between words before the turn ends

# --- Client: confidence thresholds (architecture.md §5.5) ---------------------------
# VITE_CONF_HIGH=0.85
# VITE_CONF_LOW=0.6

# --- Client: usage tracking without personal data (PostHog key is public by design) ---
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://app.posthog.com

# --- Client: demo mode (pre-loads the canonical demo data for judges; or use ?demo=1) --
# VITE_DEMO_MODE=true

# --- Client: API base URL (same origin on Vercel) -----------------------------------
# VITE_API_BASE_URL=/api
