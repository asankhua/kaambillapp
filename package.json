{
  "name": "kaambill",
  "private": true,
  "type": "module",
  "description": "KaamBill: hands-free voice billing for Indian tradespeople. Built phase by phase; built with Wispr Flow.",
  "author": "Ashish Kumar Sankhua",
  "license": "MIT",
  "workspaces": [
    "phase-*",
    "domain-*",
    "app"
  ],
  "scripts": {
    "dev": "node phase-0-setup/scripts/dev.mjs",
    "dev:web": "vite --config app/vite.config.ts",
    "dev:api": "node --env-file=.env --import tsx phase-0-setup/scripts/dev-api.ts",
    "build": "node phase-0-setup/scripts/typecheck.mjs && vite build --config app/vite.config.ts",
    "preview": "vite preview --config app/vite.config.ts",
    "start": "node --import tsx phase-0-setup/scripts/serve.ts",
    "typecheck": "node phase-0-setup/scripts/typecheck.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --config phase-6-quality-demo/vitest.config.ts",
    "test:phase": "node phase-0-setup/scripts/test-phase.mjs",
    "icons": "node phase-1-ui-ux-design/scripts/icons.mjs",
    "ui:parity": "playwright test --config phase-6-quality-demo/ui-parity.config.ts",
    "e2e": "playwright test --config phase-6-quality-demo/playwright.config.ts",
    "check:env": "node --env-file=.env --import tsx phase-0-setup/scripts/check-env.ts",
    "eval:extract": "node --env-file=.env --import tsx phase-6-quality-demo/eval/run-extract.ts",
    "rehearsal:todo": "node --env-file=.env --import tsx phase-7-domain-sprint/scripts/rehearsal-todo.ts",
    "domain:new": "node phase-7-domain-sprint/scaffold/new.mjs",
    "stt:smoke": "node --env-file=.env --import tsx phase-8-finale/scripts/stt-smoke.ts",
    "warmup": "node --import tsx phase-8-finale/scripts/warmup.ts",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml}": [
      "prettier --write"
    ]
  }
}
